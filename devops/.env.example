# Optional but useful
COMPOSE_PROJECT_NAME=auto_thesis

GHCR_OWNER=squadronxfr
GHCR_REPO=auto_thesis
APP_VERSION=main


NODE_ENV=production
LOGS_TAIL=200

# Scale agents
AGENTS_REPLICAS=10
AGENTS_CONCURRENCY=2

# HOST ports (exposés sur la machine)
FRONTEND_HOST_PORT=40000
VITE_API_URL=http://frontend:40001   # URL interne du backend


BACKEND_HOST_PORT=40001
MCP_HOST_PORT=40002

# Internal ports (dans le container)
FRONTEND_PORT=80
BACKEND_PORT=8080
MCP_PORT=8081

# DB / Redis
POSTGRES_DB=appdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

DATABASE_URL=postgres://admin:admin@postgres:5432/appdb
REDIS_URL=redis://redis:6379
MCP_URL=http://mcp:8081

# Frontend
PUBLIC_API_BASE_URL=http://frontend:40001
